#!/usr/bin/env bash
# test shim for ssh-keygen -lf FILE: a fake fingerprint per key line, with the comment
[ "$1" = -lf ] || exit 1
n=0
while IFS= read -r line; do
  case $line in '' | '#'*) continue ;; esac
  n=$((n + 1)); comment=${line##* }
  printf '256 SHA256:fakefingerprint%d %s (ED25519)\n' "$n" "$comment"
done < "$2"
